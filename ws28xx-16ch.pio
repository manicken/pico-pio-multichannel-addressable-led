.program ws28xx_16ch

;========================================================
; Timing constants for 800kHz WS2812
; These depend on system clock / OSR shift
;========================================================
.define T1 3        ; high time for '1'
.define T2 3        ; total high+low for '1'
.define T3 4        ; low time for '0'

;========================================================
; Wrap target for continuous streaming
;========================================================
.wrap_target
    pull
    out x, 16          ; grab 16 bits (as it's 2x16bit packed)
    mov pins, !null    [T1-1]   ; start high for all channels @ T1 delay
    mov pins, x         [T2-1]   ; output actual bits @ T2
    mov pins, null          [T3-2] ; finish low @ T3

    out x, 16          ; grab 16 bits (as it's 2x16bit packed)
    mov pins, !null    [T1-1]   ; start high for all channels @ T1 delay
    mov pins, x         [T2-1]   ; output actual bits @ T2
    mov pins, null          [T3-2] ; finish low @ T3
    irq set 0
.wrap

% c-sdk {
void ws28xx_16ch_program_init(PIO pio, uint sm, uint offset, uint base_pin, float clkdiv) {
    // Init GPIOs
    for (int i = 0; i < 16; i++)
        pio_gpio_init(pio, base_pin + i);
    // Set as outputs
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin, 16, true); // true mean output
    
    // Get PIO program config (which is autogenerated)
    pio_sm_config c = ws28xx_16ch_program_get_default_config(offset);

    // Set output pins
    sm_config_set_out_pins(&c, base_pin, 16);

    // Configure shift
    sm_config_set_out_shift(
        &c,
        true,   // shift right (LSB first)
        false,    // autopull
        32       // autopull every 32 bits
    );

    // explicitly disable sideset, as this SM do not use sideset pins
    sm_config_set_sideset(&c, 0, false, false);

    // Set the SM clock divider
    sm_config_set_clkdiv(&c, clkdiv);

    // Init the SM
    pio_sm_init(pio, sm, offset, &c);
}
%}

.program ws28xx_16ch_pixel_trigger_debug

;========================================================
; Wait for IRQ0 from main SM, count 12 loops, then toggle trigger pin
;========================================================

.wrap_target
wait_for_bit:
    wait irq 0          ; wait for SM1 to fire IRQ0
    irq clear 0         ; clear IRQ so next pulse can be detected
    in null, 32         ; dummy in to give some delay (optional, can be adjusted)

    ;set pins, 1 [31]    ; toggle trigger pin high for 2 cycles
    ;set pins, 0        ; set trigger pin low

    ; increment counter (use Y scratch register)
    jmp Y-- trigger_out   ; decrement Y, if zero jump to toggle
    jmp wait_for_bit     ; otherwise, wait for next IRQ
trigger_out:
    set pins, 1 [31]    ; toggle trigger pin high for 2 cycles
    set pins, 0        ; set trigger pin low
    set y, 12          ; reset counter
.wrap

%c-sdk {
void ws28xx_16ch_pixel_trigger_debug_program_init(PIO pio, uint sm, uint offset, uint pin) {
    // init the GPIO
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    // get default config from generated program
    pio_sm_config c = ws28xx_16ch_pixel_trigger_debug_program_get_default_config(offset);

    // assign output pin
    sm_config_set_out_pins(&c, pin, 1);
    sm_config_set_set_pins(&c, pin, 1);


    // sideset not used
    sm_config_set_sideset(&c, 0, false, false);

    // shift config not needed for this SM
    sm_config_set_out_shift(&c, true, false, 32);
    
    // set clock divider to 1 (same as system, adjust if needed)
    sm_config_set_clkdiv(&c, 1.0f);

    // initialize SM
    pio_sm_init(pio, sm, offset, &c);

    // reset Y counter to 12
    pio_sm_put(pio, sm, 12); // Y scratch registers can be preloaded like this
    pio_sm_exec(pio, sm, pio_encode_mov(pio_y, pio_osr)); // move value from OSR to Y if needed
}

%}